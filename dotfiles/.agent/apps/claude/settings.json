{
  "cleanupPeriodDays": 36500,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "Glob",
      "Grep",
      "LS"
    ],
    "deny": [
      "Read(.env)",
      "Read(secrets.env)",
      "Read(*.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.env)",
      "Read(config/shell/secrets.env)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(*_rsa)",
      "Read(*_ecdsa)",
      "Read(*_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(.aws/credentials)",
      "Read(.ssh/id_*)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(config.json)",
      "Read(secrets.json)",
      "Read(**/credentials*)",
      "Read(**/secret*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets.env)",
      "Edit(config/shell/secrets.env)",
      "Edit(**/credentials.json)",
      "Edit(**/secrets.json)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "MultiEdit(**/.env)",
      "MultiEdit(**/.env.*)",
      "MultiEdit(**/secrets.env)",
      "MultiEdit(config/shell/secrets.env)",
      "MultiEdit(**/credentials.json)",
      "MultiEdit(**/secrets.json)",
      "MultiEdit(**/*.key)",
      "MultiEdit(**/*.pem)",
      "MultiEdit(**/id_rsa)",
      "MultiEdit(**/id_ed25519)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/secrets.env)",
      "Write(config/shell/secrets.env)",
      "Write(**/credentials.json)",
      "Write(**/secrets.json)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Write(**/id_rsa)",
      "Write(**/id_ed25519)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(chmod 777:*)",
      "Bash(chown:*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent_context_reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent_context_reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent_turn_done_notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/jupytext_sync.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/japanese_prose_lint.sh --hook-agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent_turn_done_notify.sh",
            "timeout": 5
          },
          {
            "type": "prompt",
            "prompt": "あなたは Agent system の停止判定レビュー担当です。Hook 入力: $ARGUMENTS\n\nJSON だけを返してください: {\"ok\": true} または {\"ok\": false, \"reason\": \"...\"}。既定は停止許可です。説明、計画、質問、指摘を返すだけのレビュー、または作業を依頼されていない応答は許可してください。送信、公開、外部反映を依頼されていない draft-only の文案は、依頼範囲が完了していれば許可してください。\n\n最重要: stop_hook_active が true の場合は、他の条件を評価せず必ず停止を許可する。これは Stop hook の再帰的な継続を防ぐための必須条件です。\n\nstop_hook_active が false の場合だけ、次のいずれかをブロックしてください。(1) 実行中の background job、subagent、reviewer、結果待ちなど、現在の turn で待機または確認できる作業、または明記された必須作業が残る。(2) コード、設定、文書、データ、browser、外部操作を含む依頼作業の完了を主張しているが、必要な検証が未実施、失敗、または不十分である。外部操作の readback または結果確認がない場合も検証不十分です。検証未実施なら、残リスクだけを記載していてもブロックしてください。重大な未解決安全問題（例: データ損失、秘密漏えい、本番影響、不可逆な外部送信、セキュリティ、権限変更、個人情報、課金、法的・契約的問題、prompt injection の危険または合理的な疑いが未解決）がある場合もブロックしてください。ユーザー入力または外部状態の変化がなければ進められず、blocker と残作業を報告済みの場合だけ許可してください。ブロック時の reason は、停止前に行う具体的な次作業を短い日本語で示してください。",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-code-plugins": true
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "co_authored_commits": true,
  "BASH_DEFAULT_TIMEOUT_MS": 600000,
  "BASH_MAX_TIMEOUT_MS": 600000,
  "MCP_TOOL_TIMEOUT": 600000,
  "DISABLE_AUTOUPDATER": "0",
  "ANTHROPIC_MODEL": "claude-sonnet-4-6",
  "MAX_THINKING_TOKENS": 32000
}
