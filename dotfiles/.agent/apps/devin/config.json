{
  "agent": {
    "model": "adaptive",
    "show_history_on_continue": true
  },
  "auto_update": false,
  "notify": "smart",
  "show_path": true,
  "unicode_mode": "auto",
  "include_gitignored_files": false,
  "respect_gitignore": true,
  "permissions": {
    "allow": [],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.env)",
      "Read(config/shell/secrets.env)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/secrets.env)",
      "Write(config/shell/secrets.env)",
      "Write(**/credentials.json)",
      "Write(**/secrets.json)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Write(**/id_rsa)",
      "Write(**/id_ed25519)"
    ],
    "ask": []
  },
  "mcpServers": {
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "transport": "http"
    },
    "devin": {
      "url": "https://mcp.devin.ai/mcp",
      "transport": "http",
      "headers": {
        "Authorization": "Bearer ${DEVIN_API_KEY}"
      }
    }
  },
  "read_config_from": {
    "claude": true,
    "cursor": true,
    "windsurf": true,
    "opencode": true,
    "vscode": true,
    "zed": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/devin/hooks/agent_context_reminder.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/devin/hooks/agent_context_reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/devin/hooks/agent_turn_done_notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/devin/hooks/jupytext_sync.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/devin/hooks/japanese_prose_lint.sh --hook-agent devin",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "version": 1
}
