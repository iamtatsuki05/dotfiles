{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/agent_context_reminder.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/jupytext_sync.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/japanese_prose_lint.sh --hook-agent codex",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 -B \"$HOME/.codex/skills/yomiyasu/scripts/yomiyasu_hook.py\" --host codex"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 -B \"$HOME/.codex/skills/yomiyasu/scripts/yomiyasu_hook.py\" --host codex"
          }
        ],
        "matcher": "^Bash$|^mcp__.*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 -B \"$HOME/.codex/skills/yomiyasu/scripts/yomiyasu_hook.py\" --host codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 -B \"$HOME/.codex/skills/yomiyasu/scripts/yomiyasu_hook.py\" --host codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 2,
            "command": "python3 -B \"$HOME/.codex/skills/yomiyasu/scripts/yomiyasu_hook.py\" --host codex"
          }
        ]
      }
    ]
  }
}
