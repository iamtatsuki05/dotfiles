{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "zsh \"$HOME/.cursor/hooks/agent_context_reminder.sh\""
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "zsh \"$HOME/.cursor/hooks/agent_context_reminder.sh\""
      }
    ],
    "postToolUse": [
      {
        "command": "zsh \"$HOME/.cursor/hooks/agent_context_reminder.sh\""
      },
      {
        "command": "zsh \"$HOME/.cursor/hooks/japanese_prose_lint.sh\" --hook-agent cursor",
        "matcher": "Write",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "zsh \"$HOME/.cursor/hooks/agent_turn_done_notify.sh\""
      }
    ],
    "afterFileEdit": [
      {
        "command": "zsh \"$HOME/.cursor/hooks/jupytext_sync.sh\""
      }
    ]
  }
}
